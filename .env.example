# ==========================================================
# VIGILOX DOCUMENT INTELLIGENCE RESEARCH
# ENVIRONMENT TEMPLATE
# ==========================================================
#
# Copy this file to .env and configure your local values:
#
#     Copy-Item .env.example .env
#
# The .env file may contain secrets and is intentionally
# ignored by Git.
#
# Never commit real API keys, database passwords, or
# sensitive document data.
#
# ==========================================================


# ----------------------------------------------------------
# REQUIRED
# ----------------------------------------------------------

# Groq API key used by structured extraction experiments.
GROQ_API_KEY=your_groq_api_key_here


# PostgreSQL connection used by database-backed tests,
# migrations, and application experiments.
#
# Example:
# DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/vigilox_document_intelligence
DATABASE_URL=postgresql+psycopg://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/vigilox_document_intelligence


# ----------------------------------------------------------
# EXTRACTION MODEL
# ----------------------------------------------------------

# Default Groq model used for structured document extraction.

VIGILOX_GROQ_MODEL=openai/gpt-oss-20b


# Optional fallback model.
#
# Leave empty unless a specific experiment requires one.
#
# VIGILOX_GROQ_FALLBACK_MODEL=


# ----------------------------------------------------------
# PROVIDER RETRY / TIMEOUT SETTINGS
# ----------------------------------------------------------

VIGILOX_GROQ_MAX_RETRIES=1

VIGILOX_GROQ_READ_TIMEOUT_SECONDS=40

VIGILOX_GROQ_CONNECT_TIMEOUT_SECONDS=5

VIGILOX_EXTRACTION_ATTEMPTS=3


# ----------------------------------------------------------
# LOGGING
# ----------------------------------------------------------
#
# DEBUG | INFO | WARNING | ERROR | CRITICAL
#

VIGILOX_LOG_LEVEL=INFO


# ----------------------------------------------------------
# LOCAL STORAGE
# ----------------------------------------------------------

# Managed source-document storage.
#
# Default:
# <project-root>/storage/documents
#
# DOCUMENT_STORAGE_DIR=


# Pending uploaded files waiting for processing.
#
# Default:
# <project-root>/storage/pending
#
# Keep this separate from DOCUMENT_STORAGE_DIR.
#
# DOCUMENT_PENDING_DIR=


# ----------------------------------------------------------
# WORKER SETTINGS
# ----------------------------------------------------------

# Number of documents processed concurrently by a worker.
#
# PaddleOCR is CPU-intensive, so the default remains 1.
#
# VIGILOX_WORKER_CONCURRENCY=1


# Worker polling intervals in seconds.
#
# VIGILOX_WORKER_POLL_SECONDS=2
# VIGILOX_WORKER_IDLE_POLL_SECONDS=5


# Job lease duration used for worker recovery.
#
# VIGILOX_JOB_LEASE_SECONDS=360


# Maximum retry attempts for retryable job failures.
#
# VIGILOX_JOB_MAX_ATTEMPTS=3


# Maximum files accepted in a batch.
#
# VIGILOX_MAX_BATCH_FILES=20


# ----------------------------------------------------------
# API SETTINGS
# ----------------------------------------------------------

# Avoid eager OCR initialization in the API process when
# using the asynchronous job workflow.

VIGILOX_API_EAGER_PIPELINE=false


# Request concurrency per API process.
#
# VIGILOX_REQUEST_CONCURRENCY=20


# ----------------------------------------------------------
# DATABASE POOL
# ----------------------------------------------------------

# VIGILOX_DB_POOL_SIZE=10
# VIGILOX_DB_POOL_TIMEOUT_SECONDS=10
# VIGILOX_DB_POOL_RECYCLE_SECONDS=1800
# VIGILOX_DB_CONNECT_TIMEOUT_SECONDS=10


# ----------------------------------------------------------
# REVIEWER IDENTITY
# ----------------------------------------------------------

# Research and local testing use local reviewer identity.

VIGILOX_REVIEW_IDENTITY_MODE=local_env

VIGILOX_LOCAL_REVIEWER_ID=local-reviewer

# VIEWER | REVIEWER | ADMIN
VIGILOX_LOCAL_REVIEWER_ROLE=REVIEWER


# ----------------------------------------------------------
# OPTIONAL METRICS
# ----------------------------------------------------------

# Enables GET /metrics when required for observability tests.
#
# VIGILOX_METRICS_ENABLED=true


# ----------------------------------------------------------
# WORKER HEALTH
# ----------------------------------------------------------

# Worker heartbeat age in seconds before it is considered
# stale.
#
# VIGILOX_WORKER_STALE_AFTER_SECONDS=420


# ----------------------------------------------------------
# POSTGRESQL CLIENT TOOLS
# ----------------------------------------------------------

# Optional directory containing pg_dump and pg_restore.
#
# Example:
# VIGILOX_PG_BIN=C:/Program Files/PostgreSQL/18/bin
#
# VIGILOX_PG_BIN=